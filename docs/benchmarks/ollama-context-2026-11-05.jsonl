isk has space,"}, "done": true, "done_reason": "length", "total_duration": 74252147929, "load_duration": 3588896685, "prompt_eval_count": 56049, "prompt_eval_cached_count": 0, "prompt_eval_duration": 65678937000, "eval_count": 256, "eval_duration": 4811295000}}
