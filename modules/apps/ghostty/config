# Noctalia renders colors separately. An optional include also avoids the
# old builtin template's undo hook, which removes `theme = noctalia`.
config-file = ?themes/noctalia
font-family = "IosevkaTerm Nerd Font"
font-size = 14

window-padding-balance = true

keybind = ctrl+f=text:tmux-sessionizer\n

keybind = ctrl+tab=text:\x1b[250~
keybind = ctrl+shift+tab=text:\x1b[251~
keybind = alt+tab=text:\x1b[252~

keybind = ctrl+v=paste_from_clipboard
copy-on-select = "clipboard"

# Reuse the running process for windows launched from outside ghostty (the
# Super+Return binding execs a fresh `ghostty`). Halves window-open latency;
# the trade is that one process backs every window.
gtk-single-instance = true
