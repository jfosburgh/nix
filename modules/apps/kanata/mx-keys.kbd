;; MX Keys must be in MacOS mode to emit standard monitor-brightness events.
;; Restore the Windows-labelled physical modifiers without remapping outputs
;; generated by the home-row aliases. Keep home-row behavior in sync with kanata.kbd.
(defcfg
	process-unmapped-keys yes
	linux-continue-if-no-devs-found yes
	linux-dev-names-include ("MX Keys Keyboard")
)

(defsrc
	caps a s d f j k l ;
	lalt lmet rmet ralt
)

(defvar
	tap-time 150
	hold-time 200
)

(defalias
	escctrl (tap-hold $tap-time $hold-time esc lmet)
	a (tap-hold $tap-time $hold-time a lsft)
	s (tap-hold $tap-time $hold-time s lctl)
	d (tap-hold $tap-time $hold-time d lalt)
	f (tap-hold $tap-time $hold-time f lmet)
	j (tap-hold $tap-time $hold-time j rmet)
	k (tap-hold $tap-time $hold-time k ralt)
	l (tap-hold $tap-time $hold-time l rctl)
	; (tap-hold $tap-time $hold-time ; rsft)

	tog-off (layer-switch raw-passthrough)
	tog-on (layer-switch base)
)

(deflayer base
	@escctrl @a @s @d @f @j @k @l @;
	lmet lalt ralt rctl
)

;; Disable home-row mods but retain the physical modifier correction.
(deflayer raw-passthrough
	caps a s d f j k l ;
	lmet lalt ralt rctl
)
