name="$1"

# ../quickshell/bar (see ../autostart.lua) is the one persistent quickshell
# surface -- a long-lived PanelWindow (layer-shell), not a per-invocation
# popup, so it never shows up in `hyprctl clients` (layer-shell surfaces
# aren't toplevels) and has no `onClosed: Qt.quit()` to rely on. Detected and
# toggled by process instead: `pkill -f` (not plain `pkill quickshell`, which
# would also catch whichever popup happens to be open right now) on the
# literal `-c bar` invocation is safe from the self-match footgun `menu` in
# bindings.lua warns about, since that footgun only bites when the pattern
# text itself is embedded in the invoking command line -- this script's own
# argv is just "quickshell-toggle bar", not "quickshell -c bar".
if [ "$name" = "bar" ]; then
	if pgrep -f "quickshell -c bar" >/dev/null; then
		pkill -f "quickshell -c bar"
	else
		exec qs -c bar
	fi
	exit
fi

title="quickshell-$name"

# Each of these quickshell popups (audio/wifi/bluetooth, see
# ../quickshell/*/shell.qml) is a fresh process per open rather than a
# persistent daemon -- see audio/shell.qml's own note on why. That means
# the bar's on-click can't just always run `qs -c $name`: clicking the bar
# icon again while the popup is already open would spawn a second,
# independent instance instead of closing the first. Closing it here relies
# on each popup's `onClosed: Qt.quit()` (in shell.qml) to actually exit the
# process once its window is closed -- without that, Quickshell (built to
# run as a long-lived shell with zero or more windows) doesn't quit just
# because a window did, and the process would leak running in the
# background instead of toggling off.
if hyprctl clients -j | jq -e --arg t "$title" 'any(.[]; .title == $t)' >/dev/null; then
	hyprctl eval "return hl.dispatch(hl.dsp.window.close({window = \"title:$title\"}))" >/dev/null
else
	exec qs -c "$name"
fi
