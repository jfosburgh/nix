zi() {
  cd "$(zoxide query -i)"
}

zd() {
  if [ $# -eq 0 ]; then
    builtin cd ~ && return
  elif [ -d "$1" ]; then
    builtin cd "$1"
  else
    z "$@" && printf "\U000F17A9 " && pwd
  fi
}

open() {
  xdg-open "$@" >/dev/null 2>&1 &
}

cp2c() {
  if [[ -z "$1" ]]; then
    echo "Usage: cp2c <file>" >&2
    return 1
  fi

  wl-copy < "$1"
}

c2f() {
  if [[ -z "$1" ]]; then
    echo "Usage: create-from-clip <filename>" >&2
    return 1
  fi
  wl-paste > "$1"
}

nrs() {
  sudo nixos-rebuild switch --flake "/home/james/nix#$(hostname)"
}

hms() {
  local cache="$HOME/.cache/hms-profile"
  local profile="$1"

  if [[ -n "$profile" ]]; then
    mkdir -p "$(dirname "$cache")"
    echo "$profile" > "$cache"
  elif [[ -f "$cache" ]]; then
    profile="$(<"$cache")"
  else
    echo "hms: no profile remembered yet -- run 'hms <profile>' once (e.g. hms laptop)" >&2
    echo "available: headless, pinas, laptop, desktop, steammachine" >&2
    return 1
  fi

  home-manager switch --flake "/home/james/nix#james@$profile"
}

deploy-pinas() {
  local flake="/home/james/nix"
  local host="james@192.168.1.103"
  local hm_out="/tmp/hm-pinas-result"

  nixos-rebuild boot --flake "$flake#pinas" --target-host "$host" --build-host localhost --elevate=sudo --ask-elevate-password &&
  nix build "$flake#homeConfigurations.\"james@pinas\".activationPackage" -o "$hm_out" &&
  nix copy --to "ssh://$host" "$hm_out" &&
  ssh "$host" "$(readlink -f "$hm_out")/activate" &&
  echo "pinas: new NixOS generation set for next boot — reboot manually when ready (ssh $host sudo reboot)"
}
